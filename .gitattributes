# Normalize to LF in the repository. Without this, committing from Windows can store CRLF in
# shell scripts, and Linux then fails them with "bad interpreter: /usr/bin/env bash^M" — which
# breaks deploy.sh on the server rather than at review time.
* text=auto eol=lf

# Must be LF: executed by bash/sh on the EC2 host or inside Linux containers.
*.sh text eol=lf
gradlew text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
Caddyfile text eol=lf
*.cf text eol=lf
*.conf text eol=lf

# Must be CRLF: interpreted by Windows shells.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch: byte-for-byte content.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.keystore binary
