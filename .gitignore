# --- Secrets ---
.env
.env.*
!.env.example
# `.env.*` above also swallowed deploy/.env.prod.example, so the template the runbook tells you to
# copy was absent from a fresh clone while appearing to exist locally. The real file stays ignored
# by its own rule below.
!.env.*.example
*.pem
*.key
*.jks
*.p12
deploy/.env.prod
# Holds a real platform-admin bearer token in production; only the example belongs in git.
docker/prometheus/secrets/bearer_token
!docker/prometheus/secrets/bearer_token.example
mail-server/data/
mail-server/state/

# --- Java / Maven ---
target/
# Parallel/isolated test runs use alternate build directories (target-it, target-mail, ...).
# Plain `target/` does not match those, so they would otherwise be committed as build output.
target-*/
*.class
*.jar
# Both build wrappers ship their bootstrap jar in-tree on purpose: without it a clean clone
# cannot run ./mvnw or ./gradlew at all, which is the whole point of a wrapper.
!.mvn/wrapper/maven-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar
.mvn/timing.properties

# --- Android ---
# Machine-specific SDK path; every developer's differs.
local.properties
.gradle/
.cxx/
*.apk
*.aab
# Release signing: holds the keystore passwords in cleartext. The .jks itself is caught by *.jks
# above. Losing the keystore means never being able to update the app for existing installs or on
# Play, so it belongs in a password manager or secret store — not here, and not in git.
keystore.properties
# Firebase config. Not a credential in the way the keystore is — the API key in it is restricted to
# the registered package names — but it ties the repository to one Firebase project, which is exactly
# what a fork or a second environment must not inherit. app/google-services.json.template records
# the shape and how to fill it.
google-services.json

# --- iOS / Xcode ---
# Generated from mobile/ios/project.yml by xcodegen. Committing it would mean two sources of truth
# for the same thing, and the project file is the one that cannot be reviewed in a diff.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
# Also generated, from the entitlements block in project.yml.
mobile/ios/PrabhixOperator/*.entitlements
# Holds the signing team id and the developer's LAN address. Config.xcconfig.template records the
# shape.
Config.xcconfig

# --- Node ---
node_modules/
dist/
dist-ssr/
build/
.next/
out/
*.tsbuildinfo
.turbo/
.vite/

# Derived from the built bundle by web/scripts/generate-security-headers.mjs — the CSP hashes only
# match the artifact they were computed from, so a committed copy would go stale on the next build.
security-headers.generated.conf

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors / OS ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# --- Test / coverage ---
coverage/
.nyc_output/
