# =============================================================================
# Prabhix production environment — copy to deploy/.env.prod and fill in values.
# NEVER commit deploy/.env.prod (gitignored).
#
# Legend: [M] mandatory in production   [O] optional (has safe default)
#
# Two parsing rules matter here, because this file is read by two parsers with
# different semantics: Docker Compose's `--env-file`, and bash `source` in
# deploy/deploy.sh. A value must be valid to both.
#
# 1. Docker Compose strips a trailing `# comment` only when the value is
#    non-empty. On a blank variable the comment BECOMES the value, so
#    `JWT_SECRET=   # [M] ...` silently resolves to the literal string
#    "# [M] ...". Every variable meant to be filled in is therefore left bare,
#    with its annotation on the line above. Keep it that way when adding
#    variables.
#
# 2. Quote any value containing a space. Compose accepts it bare, but bash reads
#    `NAME=Prabhix Technologies` as `NAME=Prabhix` followed by a command named
#    `Technologies`, so the value is truncated and the deploy logs a spurious
#    "command not found". Should such a line ever land last in this file, its
#    non-zero status propagates through `source` and `set -e` aborts the deploy
#    into a rollback.
# =============================================================================

# --- Compose / infrastructure ------------------------------------------------
TAG=latest                                    # [O] Docker image tag (CI sets short SHA)
POSTGRES_DB=prabhix                           # [M]
POSTGRES_USER=prabhix                         # [M]
# [M] strong random string
POSTGRES_PASSWORD=

# --- Spring Boot -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod                   # [M]
SERVER_PORT=8080                              # [O]

# --- Database (backend) ------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/prabhix  # [M]
DB_USERNAME=prabhix                           # [M] must match POSTGRES_USER
# [M] must match POSTGRES_PASSWORD
DB_PASSWORD=
DB_POOL_MAX=20                                # [O]
DB_POOL_MIN=5                                 # [O]

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis                              # [O] compose service name
REDIS_PORT=6379                               # [O]
# [O] set if redis auth enabled
REDIS_PASSWORD=

# --- JWT / security ----------------------------------------------------------
# [M] min 64 random chars; app refuses weak/default in prod
JWT_SECRET=
JWT_ISSUER=prabhix-platform                   # [O]
JWT_ACCESS_TTL=PT15M                          # [O]
JWT_REFRESH_TTL=P30D                          # [O]
RATE_LIMIT_ENABLED=true                       # [O]

# --- Public URLs (emails, redirects, CORS) -----------------------------------
# Topology: prabhixtechnologies.com = marketing site, oneops. = the OneOps product,
# admin. = the private admin console, api. = backend, mobistack. = the separate MobiStack deployment.
MARKETING_URL=https://prabhixtechnologies.com # [M]
CONSOLE_URL=https://oneops.prabhixtechnologies.com # [M] OneOps; app. redirects here in Caddy
ADMIN_URL=https://admin.prabhixtechnologies.com # [M] the private admin console
API_URL=https://api.prabhixtechnologies.com   # [M]
# admin. must be listed or the admin console's requests are refused by the browser, not the server,
# which shows up as every page failing to load with nothing in the API log.
CORS_ORIGINS=https://prabhixtechnologies.com,https://www.prabhixtechnologies.com,https://oneops.prabhixtechnologies.com,https://admin.prabhixtechnologies.com # [M]

# --- Prabhix Identity (sibling repo, --profile identity) ---------------------
# Which service answers /api/v1/auth/* and /.well-known/* behind api.prabhixtechnologies.com.
# Leave as the backend until the identity container is deployed and its endpoints are proven:
# these paths carry live sign-in traffic, so this one line is both the cutover and the rollback.
AUTH_UPSTREAM=backend:8080                    # [O] identity:8081 to cut over
# [M] when AUTH_UPSTREAM=identity:8081 — the iss claim, and the base of both well-known URLs.
# Products compare it by string equality, so a trailing slash invalidates every token. Changing it
# later signs everyone out, so settle it before the platform starts trusting these tokens.
IDENTITY_ISSUER=https://api.prabhixtechnologies.com
# [M] when running identity — PKCS#8 PEM, newlines may be literal \n:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Blank generates a throwaway key, which the service refuses outside a local profile: it signs and
# verifies happily until a restart, and then every session is gone with nothing to point at.
IDENTITY_SIGNING_KEY=
# [O] X.509 PEM public keys that no longer sign but stay in the JWKS. Set this to the *old* public
# key for one access-token lifetime after a rotation, or every token issued in the previous 15
# minutes stops verifying the moment the new key takes over.
IDENTITY_RETIRED_PUBLIC_KEYS=

# --- Shared sign-in ----------------------------------------------------------
# Parent domain of oneops. and admin., so signing in to one covers the other. Note the leading dot
# is optional but the value must be a parent of both hostnames: set it to a domain the response is
# not served from and browsers discard the cookie silently.
SESSION_COOKIE_DOMAIN=.prabhixtechnologies.com # [M]
SESSION_COOKIE_SECURE=true                    # [O] false only for a plain-HTTP deployment

# --- Public-site origin allowlists -------------------------------------------
# The storefront, chat widget and visitor beacon are public endpoints, so they are restricted by
# Origin rather than by a token. These must list wherever the marketing site is actually served
# from, including www, or those features return 403 in the browser.
VISITOR_ALLOWED_ORIGINS=https://prabhixtechnologies.com,https://www.prabhixtechnologies.com # [M]
CHAT_ALLOWED_ORIGINS=https://prabhixtechnologies.com,https://www.prabhixtechnologies.com     # [M]
COMMERCE_ALLOWED_ORIGINS=https://prabhixtechnologies.com,https://www.prabhixtechnologies.com # [M]

# --- Frontend build/runtime (marketing container) ----------------------------
# These are inlined when the image is built, not read at runtime. CI passes them as build args;
# set them here too so `docker compose config` validates and a local build matches production.
NEXT_PUBLIC_API_URL=https://api.prabhixtechnologies.com   # [M]
NEXT_PUBLIC_SITE_URL=https://prabhixtechnologies.com      # [M]
NEXT_PUBLIC_CONSOLE_URL=https://oneops.prabhixtechnologies.com # [M]
NEXT_PUBLIC_MOBISTACK_URL=https://mobistack.prabhixtechnologies.com # [O]
# [M] Prabhix's own tenant, from OneOps → Settings → Organization.
# Blank silently disables the storefront, chat widget and visitor beacon.
NEXT_PUBLIC_ORG_SLUG=
NEXT_PUBLIC_ORG_ID=

# --- Mail — platform outbound/inbound ----------------------------------------
MAIL_FROM=no-reply@prabhixtechnologies.com    # [M]
MAIL_FROM_NAME="Prabhix Technologies"         # [O] quote any value containing spaces
MAIL_REPLY_TO=support@prabhixtechnologies.com # [O]
# LOGGING | SELF_HOSTED_SMTP | SES | SMTP_RELAY
MAIL_TRANSPORT=SMTP_RELAY                     # [M] use SELF_HOSTED_SMTP with mailserver profile
MAIL_OUTBOX_ENABLED=true                      # [O]
MAIL_IMAP_ENABLED=true                        # [O] true when using EXTERNAL_IMAP or after Dovecot bootstrap
# [M] when mailserver profile — shared secret for /api/v1/mail/inbound/lmtp
MAIL_LMTP_TOKEN=
MAIL_TRACKING_ENABLED=false                   # [O]
# [M] if tracking enabled — random HMAC secret
MAIL_TRACKING_SECRET=

# --- SMTP (Spring JavaMail — outbound worker) ----------------------------------
SMTP_HOST=postfix                             # [M] or SES endpoint
SMTP_PORT=587                                 # [M]
# [O] required if SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true                                # [O]
SMTP_STARTTLS=true                            # [O]

# --- Mail server relay (Postfix smarthost until AWS :25 unblock) -------------
# [O] e.g. [email-smtp.ap-south-1.amazonaws.com]:587
MAIL_RELAY_HOST=
MAIL_RELAY_USER=
MAIL_RELAY_PASSWORD=
MAIL_HOSTNAME=mail.prabhixtechnologies.com    # [O] HELO/PTR name

# --- Razorpay ----------------------------------------------------------------
# [M] all three. A blank webhook secret that parses as a comment would make
# forged payment webhooks verifiable, so do not leave these annotated inline.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Billing -----------------------------------------------------------------
INVOICE_PREFIX=PBX                            # [O]

# --- Object storage (S3) -----------------------------------------------------
# [O] blank for AWS S3; set for MinIO
S3_ENDPOINT=
S3_REGION=ap-south-1                          # [O]
S3_BUCKET=prabhix-prod                        # [M]
# [M] both
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false                           # [O] true for MinIO

# --- Google SSO --------------------------------------------------------------
# [O] blank disables Google sign-in
GOOGLE_CLIENT_ID=

# --- Feature toggles ---------------------------------------------------------
VIRTUAL_THREADS=true                          # [M] prod — requires Java 21 runtime image
SWAGGER_ENABLED=false                         # [M] prod
LOG_LEVEL=INFO                                # [O]

# --- Backup (used by deploy/backup.sh on host, not Spring) -------------------
AWS_DEFAULT_REGION=ap-south-1                 # [M] for S3 backups
BACKUP_S3_BUCKET=prabhix-backups              # [M]
BACKUP_RETENTION_DAYS=30                      # [O]
