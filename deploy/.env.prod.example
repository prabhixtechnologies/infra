# =============================================================================
# Prabhix production environment — copy to deploy/.env.prod and fill in values.
# NEVER commit deploy/.env.prod (gitignored).
#
# Legend: [M] mandatory in production   [O] optional (has safe default)
#
# Two parsing rules matter here, because this file is read by two parsers with
# different semantics: Docker Compose's `--env-file`, and bash `source` in
# deploy/deploy.sh. A value must be valid to both.
#
# 1. Docker Compose strips a trailing `# comment` only when the value is
#    non-empty. On a blank variable the comment BECOMES the value, so
#    `JWT_SECRET=   # [M] ...` silently resolves to the literal string
#    "# [M] ...". Every variable meant to be filled in is therefore left bare,
#    with its annotation on the line above. Keep it that way when adding
#    variables.
#
# 2. Quote any value containing a space. Compose accepts it bare, but bash reads
#    `NAME=Prabhix Technologies` as `NAME=Prabhix` followed by a command named
#    `Technologies`, so the value is truncated and the deploy logs a spurious
#    "command not found". Should such a line ever land last in this file, its
#    non-zero status propagates through `source` and `set -e` aborts the deploy
#    into a rollback.
#
# Five of the variables below are secrets, and in production they do not live in
# this file at all — they live in AWS Secrets Manager and deploy.sh fetches them
# at deploy time. They are still documented here, marked [S], because this file
# is the index of what the stack needs. See SECRETS_SOURCE below.
# =============================================================================

# --- Secrets -----------------------------------------------------------------
# [O] `env` reads the [S] variables from this file. `aws` reads them from Secrets
# Manager via deploy/secrets-env.sh and ignores whatever is in here, which is why
# deploy/aws/secrets-bootstrap.sh comments them out rather than leaving two
# copies to drift apart.
#
# Moving one secret at a time is not offered on purpose: the failure it invites
# is a password that was rotated in one place, still valid in the other, and
# working — until the old one is retired weeks later.
SECRETS_SOURCE=env

# --- Compose / infrastructure ------------------------------------------------
# TAG is the fallback for every image. Each service also has its own, and needs one whenever it is
# not on the same commit as the rest — which is most of the time now, since the six images are built
# from five repositories and a sha from one does not exist in the others.
#
# Leave a service's own tag commented out and it follows TAG. Set it and it wins, including over
# whatever this file says, because deploy.sh remembers what the caller asked for across sourcing
# this file. Rollback reads the tag off each running container rather than from here.
TAG=latest                                    # [O] fallback tag (CI sets short SHA)
# BACKEND_TAG=                                # [O] oneOps
# WEB_TAG=                                    # [O] oneOps
# ADMIN_TAG=                                  # [O] oneOps
# MARKETING_TAG=                              # [O] Platform
# IDENTITY_TAG=                               # [O] Identity
# MAILROOM_TAG=                               # [O] Mailroom
POSTGRES_DB=oneops                           # [M]
POSTGRES_USER=oneops                         # [M]
# [S] strong random string — Secrets Manager: prabhix/prod/database
POSTGRES_PASSWORD=

# --- Database host: container or RDS -----------------------------------------
# [O] Blank keeps the postgres container. Set it to the RDS endpoint to cut over; that one variable
# repoints pgbouncer, Flyway, identity, Postfix and Dovecot, because they all derive from it.
# Stop the container afterwards — leaving it running wastes 512m of a 4 GB box on a database nothing
# reads. See deploy/RUNBOOK-rds.md.
#
#   POSTGRES_HOST=prabhix-prod.abcdefghijkl.ap-south-1.rds.amazonaws.com
POSTGRES_HOST=

# [O] RDS PostgreSQL 16 defaults to rds.force_ssl=1, which refuses plaintext. `prefer` works against
# both, so it is the default; set `verify-full` once POSTGRES_HOST is an RDS endpoint and the CA
# bundle is mounted, since `require` encrypts without checking who answered.
PGBOUNCER_SERVER_TLS_SSLMODE=prefer

# --- Container registry ------------------------------------------------------
# [O] Where our own images are pulled from. deploy.sh authenticates to it before pulling, using the
# instance role, so there is no credential to put here. There is no longer a Docker Hub fallback to
# blank this back to; leaving it empty falls through to the same host hard-coded as the compose
# default, so it changes nothing.
#
# Official base images (Caddy, nginx, Node, Postgres, Redis) come from public.ecr.aws and are named
# in the compose files directly, so they are unaffected by this setting.
#
#   aws sts get-caller-identity --query Account --output text
REGISTRY=029096972251.dkr.ecr.ap-south-1.amazonaws.com
AWS_REGION=ap-south-1                         # [O] only read for the ECR login

# --- Spring Boot -------------------------------------------------------------
# [M] `valkey` switches Redis config to the cluster endpoint with TLS, which is the only way to
# reach ElastiCache Serverless. Drop it only if you are pointing at a plain Redis container.
SPRING_PROFILES_ACTIVE=prod,valkey
SERVER_PORT=8080                              # [O]

# --- Database (backend) ------------------------------------------------------
# [O] Blank uses pgbouncer, which is what you want in every case; compose assembles it from
# POSTGRES_DB. Set it only to add JDBC parameters, and keep ?prepareThreshold=0 if you do — the
# pooler hands out a different server connection per transaction and a prepared statement will not
# be there the second time.
DB_URL=
DB_USERNAME=oneops                           # [M] must match POSTGRES_USER
# [S] must match POSTGRES_PASSWORD — Secrets Manager: prabhix/prod/database
DB_PASSWORD=
DB_POOL_MAX=20                                # [O]
DB_POOL_MIN=5                                 # [O]

# [O] Migrations only, straight past pgbouncer: Flyway's lock is session-level and transaction
# pooling cannot hold one across statements. Blank derives it from POSTGRES_HOST. On RDS set it
# explicitly, because this one connection is not covered by the pooler's TLS setting:
#
#   FLYWAY_URL=jdbc:postgresql://<rds-endpoint>:5432/oneops?sslmode=verify-full
FLYWAY_URL=

# --- Database (identity) -----------------------------------------------------
# [O] Its own database and its own role, so the platform's credentials cannot read the users table.
# Blank derives the URL from POSTGRES_HOST and IDENTITY_DB_NAME. Only read when the identity profile
# is active.
IDENTITY_DB_NAME=identity
IDENTITY_DB_URL=
IDENTITY_DB_USER=identity
# [S] when running identity. A different password from POSTGRES_PASSWORD, or the separation is
# paperwork. Secrets Manager: prabhix/prod/database
IDENTITY_DB_PASSWORD=

# --- Cache: ElastiCache Valkey ------------------------------------------------
# [M] Serverless endpoint of the `prabhixtechnologies` cache, host:port. One entry, not a node list
# — the driver discovers the topology from it. Shared by the backend and identity on purpose: the
# token deny list is one keyspace that identity writes and every product reads.
#
#   aws elasticache describe-serverless-caches --region ap-south-1 \
#     --query 'ServerlessCaches[].{Name:ServerlessCacheName,Endpoint:Endpoint.Address}' --output table
REDIS_CLUSTER_NODES=
# [O] blank unless a Valkey user with a password was created. Serverless access is normally gated by
# the security group rather than by auth.
REDIS_PASSWORD=

# --- JWT / security ----------------------------------------------------------
# [S] min 64 random chars; app refuses weak/default in prod
# Secrets Manager: prabhix/prod/jwt — rotating it signs out every live session
JWT_SECRET=
JWT_ISSUER=prabhix-platform                   # [O]
JWT_ACCESS_TTL=PT15M                          # [O]
JWT_REFRESH_TTL=P30D                          # [O]
RATE_LIMIT_ENABLED=true                       # [O]

# --- Public URLs (emails, redirects, CORS) -----------------------------------
# Topology: prabhixtechnologies.com = marketing site, oneops. = the OneOps product,
# admin. = the private admin console, mail. = Mailroom, api. = backend, mobistack. = the separate
# MobiStack deployment.
MARKETING_URL=https://prabhixtechnologies.com # [M]
CONSOLE_URL=https://oneops.prabhixtechnologies.com # [M] OneOps; app. redirects here in Caddy
ADMIN_URL=https://admin.prabhixtechnologies.com # [M] the private admin console
# [M] Mailroom. Also seeds its OAuth client's redirect URI as {base}/auth/callback, so a wrong value
# here fails at /authorize rather than at deploy.
MAILROOM_URL=https://mail.prabhixtechnologies.com
# [M] MobiStack web. Also seeds prabhix-mobistack OAuth redirect as {base}/auth/callback.
MOBISTACK_URL=https://mobistack.prabhixtechnologies.com
# Company app store (APK downloads). Served by the app-store container from S3.
STORE_URL=https://store.prabhixtechnologies.com
APK_S3_BUCKET=prabhix-apk-downloads           # [M] private bucket; EC2 role reads objects
APK_S3_REGION=ap-south-1                      # [O]
API_URL=https://api.prabhixtechnologies.com   # [M]
# Every browser origin that calls the API has to be listed here. A missing one is refused by the
# browser rather than the server, which shows up as every page failing to load with nothing at all in
# the API log — the most misleading failure in this file.
CORS_ORIGINS=https://prabhixtechnologies.com,https://www.prabhixtechnologies.com,https://oneops.prabhixtechnologies.com,https://admin.prabhixtechnologies.com,https://mail.prabhixtechnologies.com # [M]

# --- Prabhix Identity (sibling repo, --profile identity) ---------------------
# Which service answers /api/v1/auth/* behind api.prabhixtechnologies.com. Leave as the backend
# until the identity container is deployed and its endpoints are proven: this path carries live
# sign-in traffic, so this one line is both the cutover and the rollback.
AUTH_UPSTREAM=backend:8080                    # [O] identity:8081 to cut over
# [O] Which service answers the hosted login page, /oauth2/*, discovery, JWKS, /userinfo and
# /connect/*. Blank means identity, unlike the line above: nothing calls these until a console is
# built with VITE_IDENTITY_ISSUER, so there is no traffic to break, and a login page that cannot be
# loaded is a login page nobody can check. Set to prabhix-backend:8080 to take it back off identity.
OIDC_UPSTREAM=
# [M] when AUTH_UPSTREAM=identity:8081 — the iss claim, and the base of both well-known URLs.
# Products compare it by string equality, so a trailing slash invalidates every token. Changing it
# later signs everyone out, so settle it before the platform starts trusting these tokens.
IDENTITY_ISSUER=https://api.prabhixtechnologies.com
# The backend also reads IDENTITY_ISSUER, and setting it is what makes the backend accept identity's
# RS256 tokens *in addition to* its own HS256 ones. Do that first and leave it: both are verified at
# once on purpose, so flipping AUTH_UPSTREAM signs nobody out. Setting AUTH_UPSTREAM first, before
# the backend trusts the issuer, means every request after a successful sign-in returns 401.
#
# [O] Where the backend fetches the keys, which is not the same question as who issued the token. It
# defaults to the identity container over the internal network. Do not point it at the issuer URL:
# that goes through Caddy to whatever AUTH_UPSTREAM names, which is the backend itself before
# cutover, so it would 404 exactly when it matters.
IDENTITY_JWKS_URI=
# [S] when running identity — PKCS#8 PEM, newlines may be literal \n:
# Secrets Manager: prabhix/prod/identity-signing-key
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Blank generates a throwaway key, which the service refuses outside a local profile: it signs and
# verifies happily until a restart, and then every session is gone with nothing to point at.
IDENTITY_SIGNING_KEY=
# [O] X.509 PEM public keys that no longer sign but stay in the JWKS. Set this to the *old* public
# key for one access-token lifetime after a rotation, or every token issued in the previous 15
# minutes stops verifying the moment the new key takes over.
IDENTITY_RETIRED_PUBLIC_KEYS=

# --- Shared sign-in ----------------------------------------------------------
# Parent domain of oneops. and admin., so signing in to one covers the other. Note the leading dot
# is optional but the value must be a parent of both hostnames: set it to a domain the response is
# not served from and browsers discard the cookie silently.
SESSION_COOKIE_DOMAIN=.prabhixtechnologies.com # [M]
SESSION_COOKIE_SECURE=true                    # [O] false only for a plain-HTTP deployment

# --- Public-site origin allowlists -------------------------------------------
# The storefront, chat widget and visitor beacon are public endpoints, so they are restricted by
# Origin rather than by a token. These must list wherever the marketing site is actually served
# from, including www, or those features return 403 in the browser.
VISITOR_ALLOWED_ORIGINS=https://prabhixtechnologies.com,https://www.prabhixtechnologies.com # [M]
CHAT_ALLOWED_ORIGINS=https://prabhixtechnologies.com,https://www.prabhixtechnologies.com     # [M]
COMMERCE_ALLOWED_ORIGINS=https://prabhixtechnologies.com,https://www.prabhixtechnologies.com # [M]

# --- Frontend build/runtime (marketing container) ----------------------------
# These are inlined when the image is built, not read at runtime. CI passes them as build args;
# set them here too so `docker compose config` validates and a local build matches production.
NEXT_PUBLIC_API_URL=https://api.prabhixtechnologies.com   # [M]
NEXT_PUBLIC_SITE_URL=https://prabhixtechnologies.com      # [M]
NEXT_PUBLIC_CONSOLE_URL=https://oneops.prabhixtechnologies.com # [M]
NEXT_PUBLIC_MOBISTACK_URL=https://mobistack.prabhixtechnologies.com # [O]
# [M] Prabhix's own tenant, from OneOps → Settings → Organization.
# Blank silently disables the storefront, chat widget and visitor beacon.
NEXT_PUBLIC_ORG_SLUG=
NEXT_PUBLIC_ORG_ID=

# --- Mail — platform outbound/inbound ----------------------------------------
MAIL_FROM=no-reply@prabhixtechnologies.com    # [M]
MAIL_FROM_NAME="Prabhix Technologies"         # [O] quote any value containing spaces
MAIL_REPLY_TO=support@prabhixtechnologies.com # [O]
# LOGGING | SELF_HOSTED_SMTP | SES | SMTP_RELAY
MAIL_TRANSPORT=SMTP_RELAY                     # [M] use SELF_HOSTED_SMTP with mailserver profile
MAIL_OUTBOX_ENABLED=true                      # [O]
MAIL_IMAP_ENABLED=true                        # [O] true when using EXTERNAL_IMAP or after Dovecot bootstrap
# [M] when mailserver profile — shared secret for /api/v1/mail/inbound/lmtp
MAIL_LMTP_TOKEN=
MAIL_TRACKING_ENABLED=false                   # [O]
# [M] if tracking enabled — random HMAC secret
MAIL_TRACKING_SECRET=

# --- SMTP (Spring JavaMail — outbound worker) ----------------------------------
SMTP_HOST=postfix                             # [M] or SES endpoint
SMTP_PORT=587                                 # [M]
# [O] required if SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true                                # [O]
SMTP_STARTTLS=true                            # [O]

# --- Mail server relay (Postfix smarthost until AWS :25 unblock) -------------
# [O] e.g. [email-smtp.ap-south-1.amazonaws.com]:587
MAIL_RELAY_HOST=
MAIL_RELAY_USER=
MAIL_RELAY_PASSWORD=
MAIL_HOSTNAME=mail.prabhixtechnologies.com    # [O] HELO/PTR name

# --- Razorpay ----------------------------------------------------------------
# [M] all three. A blank webhook secret that parses as a comment would make
# forged payment webhooks verifiable, so do not leave these annotated inline.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Billing -----------------------------------------------------------------
INVOICE_PREFIX=PBX                            # [O]

# --- Object storage (S3) -----------------------------------------------------
# [O] blank for AWS S3; set for MinIO
S3_ENDPOINT=
S3_REGION=ap-south-1                          # [O]
S3_BUCKET=prabhix-prod                        # [M]
# [M] both
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false                           # [O] true for MinIO

# --- Google SSO --------------------------------------------------------------
# [O] blank disables Google sign-in
GOOGLE_CLIENT_ID=

# --- Feature toggles ---------------------------------------------------------
VIRTUAL_THREADS=true                          # [M] prod — needs a Java 21+ image; prod runs 25
SWAGGER_ENABLED=false                         # [M] prod
LOG_LEVEL=INFO                                # [O]

# --- Backup (used by deploy/backup.sh on host, not Spring) -------------------
AWS_DEFAULT_REGION=ap-south-1                 # [M] for S3 backups
BACKUP_S3_BUCKET=prabhix-backups              # [M]
BACKUP_RETENTION_DAYS=30                      # [O]
