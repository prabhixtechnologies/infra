# Prabhix production reverse proxy — automatic TLS via Let's Encrypt.
# Caddy obtains and renews certificates; no separate certbot cron.
{
	email admin@prabhixtechnologies.com

	# Two loggers, deliberately: Caddy's own diagnostics on stderr where `docker logs caddy` reads
	# them, and HTTP access logs in a file for shipping and fail2ban.
	#
	# This used to be a single unnamed `log` block pointing at the file. An unnamed block *replaces*
	# the default logger rather than adding to it, so every TLS and ACME message went to the file
	# too and `docker logs caddy` returned nothing at all. A proxy serving a certificate no client
	# would trust was therefore indistinguishable from a healthy one, and the only record of why sat
	# in a file inside the container.
	#
	# The file was also misnamed: access logging is not implied by configuring a sink, it needs the
	# `log` directive on the sites themselves. Without it the file held startup diagnostics and not
	# one access entry, which is why the site snippet below now enables it.
	log default {
		output stderr
		format console
		exclude http.log.access
	}
	log access {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
		include http.log.access
	}
}

# Headers every host gets. Transport-level concerns only — the CSP is deliberately not here.
#
# It used to be, spelled out in full, while web/security-headers.conf spelled out its own copy. Only
# one of the two could ever win (Caddy's `header` replaces what the upstream sent, so nginx's copy
# was dead weight in production), and nothing failed when they disagreed, so the ineffective copy
# could be edited with apparent success. Each app now owns its own policy, and can therefore be as
# strict as its own contents allow: the console names a hash for its inline script, and the
# marketing site carries a per-request nonce, neither of which a shared string could express.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
	encode gzip zstd
	# Every host imports this snippet, directly or via no_document_headers, so one `log` here is what
	# turns access logging on everywhere without repeating it per site.
	log
}

# For hosts that serve no HTML document of their own: the API and the redirect-only names.
# Deliberately far stricter than any app policy, because a document is not expected here.
#
# This floor is NOT applied to the app hosts, and that is the whole point of it being a separate
# snippet. It used to be in `security_headers` with a `?` prefix — "set only if the response does not
# already carry one" — which reads as a safe default and is not one for a host that serves HTML. When
# the marketing container was left on an image built before its CSP middleware existed, it sent no
# policy, so the floor applied to a real document and `default-src 'none'` blocked every stylesheet,
# script and font on the page. The site returned 200 and rendered as unstyled text.
#
# An app that fails to send its own policy should degrade to being unprotected, not to being broken:
# the first is caught by the CSP checks in deploy/smoke.ps1, the second is caught by a customer.
(no_document_headers) {
	import security_headers
	header {
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none';"
	}
}

# Marketing site — apex + www. Sends its own per-request nonce CSP from src/proxy.ts.
prabhixtechnologies.com, www.prabhixtechnologies.com {
	import security_headers
	reverse_proxy marketing:3000
}

# OneOps — the operator console sold to customers (React SPA behind nginx, which serves the
# generated security-headers.conf carrying the hash of the inline theme bootstrap).
oneops.prabhixtechnologies.com {
	import security_headers
	reverse_proxy prabhix-web:80
}

# Prabhix's own console: the same tenant pages plus the platform-wide Ops Hub. A separate image, not
# the same one on a second name, so the customer product does not ship the cross-tenant code.
#
# Both hosts sit under prabhixtechnologies.com, which is what lets the session cookie cover both and
# means signing in on one carries over to the other.
admin.prabhixtechnologies.com {
	import security_headers
	reverse_proxy admin:80
}

# The console used to live here. Kept as a permanent redirect so existing bookmarks, and the
# links in transactional email already delivered to people's inboxes, keep working.
app.prabhixtechnologies.com {
	import no_document_headers
	redir https://oneops.prabhixtechnologies.com{uri} permanent
}

# Extra sites, dropped in as files rather than written here.
#
# For a hostname whose A record has not moved here yet. A site block cannot simply be added above
# and left dormant: Caddy tries to obtain a certificate for every name it is configured to serve, so
# a block for a hostname whose DNS still points somewhere else means failing ACME orders on a loop,
# against a rate limit that is counted per name and per week. Such a block ships as
# `deploy/conf.d/<name>.caddyfile.example`, and enabling it is a rename — which is also the
# rollback. MobiStack arrived on this box that way and, its DNS long settled, is a normal block
# below now; the store is the one fragment left.
#
# A directory mount rather than more single files, for the inode reason described on the caddy
# volumes in docker-compose.yml: a bind-mounted file is replaced by `git pull`, and the container
# keeps serving the contents of the inode it opened at start.
import /etc/caddy/conf.d/*.caddyfile

# MobiStack — the repair-shop product, on this box since the consolidation.
#
# Upstreams are the `mobistack-backend` and `mobistack-web` services behind the `mobistack` compose
# profile. They carry the product's name for a reason worth keeping: MobiStack used to run as a
# second compose project on this network with services called `backend` and `web`, Docker's embedded
# DNS registered those as aliases alongside the platform's own, and a lookup of `backend` returned two
# A records — so Caddy round-robined half of MobiStack's API traffic into the wrong application. A
# service whose name is unique on the network cannot do that.
mobistack.prabhixtechnologies.com {
	# security_headers, not no_document_headers: this host serves an HTML application.
	#
	# The snippet deliberately carries no CSP, which is what lets MobiStack keep its own — the one
	# in MobiStack's web/nginx.conf, with the Razorpay script, frame and connect allowances that a
	# shared policy could not express. Caddy replaces upstream headers it also sets, so the CSP
	# survives only because the snippet stays out of it.
	import security_headers

	# Restores what nginx sends and the shared snippet would otherwise overwrite. MobiStack is never
	# framed, including by Prabhix's own hosts, so DENY rather than the snippet's SAMEORIGIN.
	header X-Frame-Options DENY

	# APK downloads are published only on store.prabhixtechnologies.com (S3-backed). Legacy
	# /download/android bookmarks permanently redirect there; nothing is streamed from this host.
	handle /download/android* {
		redir https://store.prabhixtechnologies.com/mobistack/android.apk permanent
	}
	handle /api/v1/public/downloads/android* {
		redir https://store.prabhixtechnologies.com/mobistack/android.apk permanent
	}
	handle /download/ios* {
		reverse_proxy mobistack-backend:8080
	}
	handle /api/* {
		reverse_proxy mobistack-backend:8080
	}
	handle /actuator/health* {
		reverse_proxy mobistack-backend:8080
	}
	# Routed here rather than left to fall through to the web container, whose nginx also proxies
	# these two paths; one hop is better than two, and Swagger is off in production anyway.
	handle /swagger-ui* {
		reverse_proxy mobistack-backend:8080
	}
	handle /v3/api-docs* {
		reverse_proxy mobistack-backend:8080
	}

	handle {
		reverse_proxy mobistack-web:80
	}

	# Same arrangement as mail. below: the images come from another repository, the services sit
	# behind a profile, and a host without that profile enabled should say so rather than 502.
	handle_errors 502 503 {
		header Content-Type "text/plain; charset=utf-8"
		respond "MobiStack is not deployed on this host yet.

The hostname is live and TLS is valid, but no MobiStack container is running behind it.
Add mobistack to COMPOSE_PROFILES once its images have been published, and set
MOBISTACK_BACKEND_TAG and MOBISTACK_WEB_TAG to the MobiStack commit you want.
" 503
	}
}

# API-only host. Everything here is JSON or a file download, never a framed document, so the
# document headers the sibling host needs would be noise — no_document_headers is the right snippet.
#
# MobiStack's canonical origin stays mobistack.prabhixtechnologies.com: magic links, invoices and
# redirects are all built from FIXFLOW_PUBLIC_ORIGIN and are unaffected by this name existing. This
# is a second way in, not a second identity. It exists because the record already did — an unclaimed
# name on an instance that answers on 443 is a certificate error rather than either a working host or
# NXDOMAIN.
api.mobistack.prabhixtechnologies.com {
	import no_document_headers
	reverse_proxy mobistack-backend:8080
}

# Spring Boot API — one origin for clients, whichever service is behind it.
#
# Authentication is moving into the Identity service, and routing it through this host rather than
# giving it its own name is what makes that a deployment change instead of a client change: the web
# apps, both Android apps and every link already sitting in someone's inbox keep calling
# api.prabhixtechnologies.com. It also avoids a second CORS origin and a second cookie domain for
# the sign-in flow, which is the part of this that is easy to get subtly wrong. The extractions after
# it — mail is the intended next one — become a routing change here.
#
# JSON calls are selected by path, not by a shared /api/v1/auth prefix: /api/v1/identity/* is Identity
# and /api/v1/oneops/* is the platform backend. MobiStack stays on mobistack.prabhixtechnologies.com.
#
# OIDC_UPSTREAM serves the hosted login page, discovery, JWKS, the authorization endpoints, and
# /api/v1/identity/*. It defaults to identity. On a stack running without the identity profile those
# paths 502 rather than 404, because Caddy resolves the upstream per request and there is no such host.
# Setting OIDC_UPSTREAM back to prabhix-backend:8080 restores the old 404 and is the rollback.
api.prabhixtechnologies.com {
	import no_document_headers

	# Order matters: Caddy evaluates handle blocks in the order written, and the bare `handle` at the
	# end is the catch-all. Putting it first would swallow everything.

	# Service-to-service only, and first so that nothing added below can accidentally expose it. The
	# catch-all at the end forwards everything it is given to the backend, so without this the endpoint
	# that creates an organization and grants its ownership would be a public URL with a shared secret
	# as its only defence. Both services answer under this prefix and neither should be reachable here.
	#
	# 404 rather than 403, because a 403 confirms there is something there.
	handle /internal* {
		respond 404
	}

	# JSON APIs are split by product prefix, so sign-in and tenant calls no longer share /api/v1/auth.
	# Identity answers who someone is. OneOps answers organizationId and permissions, and invitations,
	# because those rows live in the platform database.
	handle /api/v1/identity/* {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	handle /api/v1/oneops/* {
		reverse_proxy prabhix-backend:8080
	}

	# OIDC discovery and JWKS. Every product reads these before it can verify a single token, so they
	# have to be served from the origin named in the issuer claim.
	handle /.well-known/* {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	# The OAuth2 and OpenID Connect surface, and the hosted login page it redirects to.
	#
	# /login and /assets are here because the login page has to be served from this origin. That is
	# the whole mechanism of single sign-on: the session cookie is set on the origin that rendered the
	# form, so a second product's /oauth2/authorize finds an existing session and returns a code
	# without asking for a password again. Serve the page from a product's own hostname and the
	# browser ends up with one session per product, which is the opposite of what this is for.
	handle /oauth2/* {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	handle /userinfo {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	handle /connect/* {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	handle /login* {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	# Hosted account page (password / passkeys / sessions). Same origin as /login so the
	# session cookie is visible. Unpinned, the catch-all sends it to the platform backend.
	handle /account* {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	# Hosted session end. Without this, /logout hits the catch-all backend and the pbx_session
	# cookie on the parent domain is never cleared.
	handle /logout* {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	# Creating an account, on the same origin for the same reason as signing into one: the session it
	# ends in has to belong to this origin, or someone who just signed up is signed in to nothing.
	#
	# Its own handle rather than an extension of /login*, because it is not under that prefix and
	# without this the catch-all below sends it to the backend — which has no such path and answers
	# with a JSON 401, so the page looks like it needs an account to create an account.
	handle /signup {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	# The login page's own stylesheet and script, and nothing else: no product serves anything from
	# this origin under /assets.
	handle /assets/* {
		reverse_proxy {$OIDC_UPSTREAM:identity:8081}
	}

	# The backend needs the client IP and original scheme/host for rate limiting and absolute URL
	# generation. Caddy sets X-Forwarded-For, -Proto and -Host on its own, so the explicit header_up
	# lines that used to be here only produced "Unnecessary header_up" warnings on every start.
	handle {
		reverse_proxy prabhix-backend:8080
	}
}

# id.prabhixtechnologies.com is deliberately absent until its A record exists. Caddy asks Let's
# Encrypt for a certificate per site name at startup, and a name that does not resolve fails the
# HTTP-01 challenge and retries with backoff — noise in the logs of a proxy that is otherwise fine,
# for a hostname nothing yet points at. The issuer is api.prabhixtechnologies.com for now, which is
# where discovery and JWKS are served above; moving it later invalidates every token in flight, so it
# is a one-time change to make before the platform starts trusting the new tokens, not after.

# Prabhix Mailroom — a mail client for a person's own address.
#
# This name has always resolved here for MX/IMAP/SMTP, so that PTR aligns; ports 25/587/993 are still
# served by the mailserver compose profile rather than by Caddy, and nothing about that changes. What
# changes is 443: it used to redirect to the console's shared-inbox screen, because there was no mail
# web app to send anybody to. Now there is.
#
# Mailroom is not the console's inbox. That one is a support queue — assignment, SLA clocks, canned
# replies. This is somebody's own mail, with folders and stars and nobody else's tickets in it.
mail.prabhixtechnologies.com {
	import security_headers
	reverse_proxy mailroom:80

	# The mailroom container is behind a compose profile, because its image is published by the
	# Mailroom repository and tagged with that repository's commits rather than this one's. So on a
	# host where that profile is not enabled this name resolves, terminates TLS, and then fails —
	# and a bare 502 from Caddy reads as an outage rather than as a service that was never deployed.
	#
	# Only 502 and 503 are rewritten. A 500 from a Mailroom that is genuinely running and genuinely
	# broken must keep saying so, rather than being dressed up as "not deployed yet".
	handle_errors 502 503 {
		header Content-Type "text/plain; charset=utf-8"
		respond "Prabhix Mailroom is not deployed on this host yet.

The hostname is live and TLS is valid, but no Mailroom container is running behind it.
Enable it with COMPOSE_PROFILES=mailroom once its image has been published, and set
MAILROOM_TAG to the Mailroom commit you want.
" 503
	}
}
