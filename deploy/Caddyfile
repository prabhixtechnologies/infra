# Prabhix production reverse proxy — automatic TLS via Let's Encrypt.
# Caddy obtains and renews certificates; no separate certbot cron.
{
	email admin@prabhixtechnologies.com
	# JSON access logs for log shipping / fail2ban.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
}

# Headers every host gets. Transport-level concerns only — the CSP is deliberately not here.
#
# It used to be, spelled out in full, while web/security-headers.conf spelled out its own copy. Only
# one of the two could ever win (Caddy's `header` replaces what the upstream sent, so nginx's copy
# was dead weight in production), and nothing failed when they disagreed, so the ineffective copy
# could be edited with apparent success. Each app now owns its own policy, and can therefore be as
# strict as its own contents allow: the console names a hash for its inline script, and the
# marketing site carries a per-request nonce, neither of which a shared string could express.
#
# The `?` prefix means "set only if the response does not already carry one", so an app's policy
# passes through untouched and anything without one still gets a floor rather than nothing.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Floor for hosts that serve no HTML of their own: the API, and the redirect-only hosts.
		# Deliberately far stricter than any app policy, because a document is not expected here.
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none';"
		-Server
	}
	encode gzip zstd
}

# Marketing site — apex + www
prabhixtechnologies.com, www.prabhixtechnologies.com {
	import security_headers
	reverse_proxy marketing:3000
}

# OneOps — the operator console sold to customers (React SPA behind nginx).
oneops.prabhixtechnologies.com {
	import security_headers
	reverse_proxy web:80
}

# Prabhix's own console: the same tenant pages plus the platform-wide Ops Hub. A separate image, not
# the same one on a second name, so the customer product does not ship the cross-tenant code.
#
# Both hosts sit under prabhixtechnologies.com, which is what lets the session cookie cover both and
# means signing in on one carries over to the other.
admin.prabhixtechnologies.com {
	import security_headers
	reverse_proxy admin:80
}

# The console used to live here. Kept as a permanent redirect so existing bookmarks, and the
# links in transactional email already delivered to people's inboxes, keep working.
app.prabhixtechnologies.com {
	import security_headers
	redir https://oneops.prabhixtechnologies.com{uri} permanent
}

# MobiStack is a separate deployment with its own compose stack, so there is no upstream here.
# Point mobistack.prabhixtechnologies.com at that host in DNS. If it is ever co-located, add:
#   mobistack.prabhixtechnologies.com {
#   	import security_headers
#   	reverse_proxy mobistack:80
#   }

# Spring Boot API
api.prabhixtechnologies.com {
	import security_headers
	reverse_proxy backend:8080 {
		# Preserve client IP and proto for rate limiting and absolute URL generation.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

# mail.prabhixtechnologies.com exists for MX/IMAP/SMTP: its A record points here so PTR aligns, and
# ports 25/587/993 are served by the mailserver compose profile rather than Caddy.
#
# It answers on HTTPS purely so a browser does not dead-end. With no site block Caddy issued no
# certificate for the name, so visiting it failed the TLS handshake with nothing to explain why —
# which reads as "the mail UI is broken" when in fact there has never been a mail web app. The mail
# interface is a section of the console, so send people there.
mail.prabhixtechnologies.com {
	import security_headers
	# Deliberately not forwarding {uri}: this host has no sub-paths of its own, and appending them
	# would invent console routes like /inbox/settings that do not exist.
	redir https://oneops.prabhixtechnologies.com/inbox permanent
}
