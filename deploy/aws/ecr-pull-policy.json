{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuthTokenCannotBeScoped",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/backend",
        "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/web",
        "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/admin",
        "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/marketing",
        "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/identity",
        "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/mailroom",
        "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/mail",
        "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/mobistack-backend",
        "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/mobistack-web"
      ]
    }
  ]
}
