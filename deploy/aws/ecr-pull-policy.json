{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetAuthorizationTokenIsAccountWide",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:029096972251:repository/prabhix/*"
    },
    {
      "Sid": "SendMailThroughSes",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail",
        "ses:GetSendQuota",
        "ses:GetAccount",
        "ses:GetEmailIdentity"
      ],
      "Resource": "*"
    }
  ]
}
