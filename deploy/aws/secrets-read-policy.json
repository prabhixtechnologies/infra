{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProductionSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/database-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/jwt-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/identity-signing-key-*"
      ]
    }
  ]
}
