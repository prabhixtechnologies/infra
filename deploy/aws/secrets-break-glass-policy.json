{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BreakGlassSecretRotation",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/database-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/jwt-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/identity-signing-key-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/mail-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/payment-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/redis-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/monitoring-*"
      ]
    }
  ]
}
