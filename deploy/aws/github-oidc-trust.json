{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsOnMainAndMasterOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::029096972251:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:repository_owner": "prabhixtechnologies"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": "repo:prabhixtechnologies/*"
        }
      }
    }
  ]
}
