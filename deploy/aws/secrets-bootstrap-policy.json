{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BootstrapReadWriteProductionSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:TagResource",
        "secretsmanager:UpdateSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/database-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/jwt-*",
        "arn:aws:secretsmanager:ap-south-1:029096972251:secret:prabhix/prod/identity-signing-key-*"
      ]
    },
    {
      "Sid": "ListForBootstrapOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:ListSecrets",
      "Resource": "*"
    }
  ]
}
