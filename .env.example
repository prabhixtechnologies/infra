# =============================================================================
# Prabhix full-stack environment variables
# Copy to .env for local docker compose, or use deploy/.env.prod.example for prod.
#
# Legend: [M] must set for production   [D] has safe default for local dev
#
# One parsing rule matters here: Docker Compose strips a trailing `# comment`
# only when the value is non-empty. On a blank variable the comment BECOMES the
# value, so `S3_SECRET_KEY=   # [M] prod` silently resolves to the literal
# string "# [M] prod". Variables intended to be blank are therefore left bare,
# with their annotation on the line above. Keep it that way when adding more.
# =============================================================================

# --- Docker Compose infrastructure -------------------------------------------
COMPOSE_PROJECT_NAME=prabhix                      # [D]
POSTGRES_DB=prabhix                               # [D]
POSTGRES_USER=prabhix                             # [D]
POSTGRES_PASSWORD=prabhix                         # [D] change in prod
TAG=latest                                        # [D] image tag for prod compose

# --- Spring Boot ----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev                          # [D] prod uses "prod"
SERVER_PORT=8080                                    # [D]
VIRTUAL_THREADS=false                               # [D] true in prod (Java 21)
SWAGGER_ENABLED=true                                # [D] false in prod
LOG_LEVEL=INFO                                      # [D] DEBUG for local backend

# --- Database -------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/prabhix     # [D] compose overrides host to postgres
DB_USERNAME=prabhix                                 # [D]
DB_PASSWORD=prabhix                                 # [M] prod
DB_POOL_MAX=20                                      # [D]
DB_POOL_MIN=5                                       # [D]

# --- Redis ----------------------------------------------------------------------
REDIS_HOST=localhost                                # [D] compose: redis
REDIS_PORT=6379                                     # [D]
# [D] blank locally; set if redis auth enabled
REDIS_PASSWORD=

# --- JWT / security -------------------------------------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdefghijklmnop  # [M] prod — 64+ chars
JWT_ISSUER=prabhix-platform                         # [D]
JWT_ACCESS_TTL=PT15M                                # [D]
JWT_REFRESH_TTL=P30D                                # [D]
RATE_LIMIT_ENABLED=true                             # [D]

# --- Public URLs ----------------------------------------------------------------
# Local topology mirrors prod: marketing on 3000, OneOps console on 5173, admin console on 5174,
# API on 8080.
MARKETING_URL=http://localhost:3000                 # [M] prod HTTPS URLs
CONSOLE_URL=http://localhost:5173                   # [M] prod: https://oneops.prabhixtechnologies.com
ADMIN_URL=http://localhost:5174                     # [M] prod: https://admin.prabhixtechnologies.com
API_URL=http://localhost:8080                       # [M] prod
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174  # [M] prod

# --- Shared sign-in -------------------------------------------------------------
# Parent domain of every console hostname, so one login covers oneops. and admin. Empty locally,
# where the two consoles differ by port and a cookie cannot be scoped to a port anyway.
SESSION_COOKIE_DOMAIN=                              # [D] prod: .prabhixtechnologies.com
SESSION_COOKIE_SECURE=false                         # [D] prod: true

# --- Web console (Vite build args) ----------------------------------------------
# The console is a static SPA behind nginx with no API proxy, so the browser calls this
# directly: it must be reachable from the browser, never a container name.
# Origin only — the console appends /api/v1 itself. The Android client takes the opposite
# convention and includes the version, so the two are easy to mix up; the console normalises a
# base that already ends in /api/v1 rather than issuing requests to /api/v1/api/v1/...
VITE_API_URL=http://localhost:8080                  # [D] prod: https://api...
VITE_RAZORPAY_KEY_ID=                               # [D] blank hides Razorpay checkout
VITE_GOOGLE_SSO_ENABLED=false                       # [D] true only if GOOGLE_CLIENT_ID is set

# --- Marketing site (Next.js) -------------------------------------------------
# NEXT_PUBLIC_* is inlined at build time, so these matter to `npm run build` and to
# the Docker build args — not to the running container.
NEXT_PUBLIC_API_URL=http://localhost:8080           # [M] host-mode `npm run dev` only

# [D] Used only by the marketing *image build*. The browser never sees this: client code
# calls the same-origin /api/backend prefix, which the Next server proxies. That proxy runs
# inside the container, where localhost is the Next server itself — so the container build
# needs a service name. Deliberately not NEXT_PUBLIC_API_URL, so a host-mode localhost value
# above cannot leak into the image and silently break every public API call.
MARKETING_INTERNAL_API_URL=http://backend:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # [M] prod
NEXT_PUBLIC_CONSOLE_URL=http://localhost:5173       # [M] prod
NEXT_PUBLIC_MOBISTACK_URL=https://mobistack.prabhixtechnologies.com  # [D]
# [M] Prabhix's own tenant, from OneOps → Settings → Organization.
# Blank disables the storefront, chat widget and visitor beacon.
NEXT_PUBLIC_ORG_SLUG=
NEXT_PUBLIC_ORG_ID=

# --- Mail — platform identity & transport -------------------------------------
MAIL_FROM=no-reply@prabhixtechnologies.com          # [D]
MAIL_FROM_NAME=Prabhix Technologies                 # [D]
MAIL_REPLY_TO=support@prabhixtechnologies.com       # [D]
MAIL_TRANSPORT=LOGGING                              # [D] local: LOGGING or SMTP_RELAY
MAIL_OUTBOX_ENABLED=true                            # [D]
MAIL_IMAP_ENABLED=false                             # [D] true when polling external mail
# [M] if using self-hosted LMTP push
MAIL_LMTP_TOKEN=
MAIL_TRACKING_ENABLED=false                         # [D]
MAIL_TRACKING_SECRET=dev-tracking-secret            # [M] if tracking enabled

# --- SMTP (JavaMail — used by MAIL_TRANSPORT SMTP_RELAY / SELF_HOSTED_SMTP) -----
SMTP_HOST=localhost                                 # [D] compose local: mailpit
SMTP_PORT=1025                                      # [D] Mailpit default
# [D] blank locally; Mailpit needs no auth
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false                                     # [D]
SMTP_STARTTLS=false                                 # [D]

# --- Self-hosted mail server (mailserver profile) -------------------------------
MAIL_HOSTNAME=mail.prabhixtechnologies.com          # [D]
MAIL_ALLOWED_DOMAINS=prabhixtechnologies.com        # [D]
# [D] smarthost until AWS :25 unblock
MAIL_RELAY_HOST=
MAIL_RELAY_USER=
MAIL_RELAY_PASSWORD=

# --- Razorpay -------------------------------------------------------------------
# [M] prod — test keys are fine locally
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Billing ----------------------------------------------------------------------
INVOICE_PREFIX=PBX                                  # [D]

# --- S3-compatible storage ------------------------------------------------------
# [D] blank = AWS; http://minio:9000 locally
S3_ENDPOINT=
S3_REGION=ap-south-1                                # [D]
S3_BUCKET=prabhix-local                             # [M] prod bucket name
# [M] prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true                                  # [D] false for AWS S3

# --- Google SSO -----------------------------------------------------------------
# [D] blank = feature disabled
GOOGLE_CLIENT_ID=

# --- Backup (host scripts) ------------------------------------------------------
AWS_DEFAULT_REGION=ap-south-1                       # [M] for backup.sh
BACKUP_S3_BUCKET=prabhix-backups                    # [M]
BACKUP_RETENTION_DAYS=30                            # [D]
